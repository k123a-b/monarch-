# Supabase: Connect > Transaction pooler connection string (port 6543).
# Do not add ?sslmode=.
# Vercel's Supabase integration sets POSTGRES_URL instead; that works too.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Auth.js: generate with `openssl rand -base64 32`.
AUTH_SECRET=

# Google Cloud Console > Credentials > OAuth client ID (Web application).
# Redirect URI: https://YOUR-DOMAIN/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: only for the scheduled /api/cron/settle sweep (Vercel Pro).
CRON_SECRET=
